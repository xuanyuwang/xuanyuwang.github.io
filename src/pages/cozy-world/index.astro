---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Cozy World";
const description = "A tiny, peaceful world in an autumn forest.";
---

<BaseLayout title={`${title} | Xuanyu Wang`} description={description}>
  <section class="game-intro">
    <p class="eyebrow">A tiny autumn world</p>
    <h1>{title}</h1>
    <p>{description}</p>

    <div
      id="cozy-world-game"
      aria-label="Cozy World game area"
    ></div>

    <noscript>
      <p>Cozy World requires JavaScript to run.</p>
    </noscript>

    <p class="meta">First playable version in development.</p>
  </section>

  <style>
    .game-intro {
      padding-bottom: 3rem;
    }

    .eyebrow {
      margin-top: 2rem;
      color: #9a512d;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .game-intro h1 {
      margin: 0;
    }

    #cozy-world-game {
  width: 100%;
  height: clamp(420px, 72dvh, 700px);
  margin-top: 1.5rem;
  overflow: hidden;
  border: 1px solid #7b4c2c;
  border-radius: 16px;
  background: #536b45;
  box-shadow: 0 20px 50px rgb(62 40 23 / 18%);
  touch-action: none;
}

:global(#cozy-world-game canvas) {
  display: block;
}
  </style>
  <script>
    import "../../games/cozy-world/main";
  </script>
</BaseLayout>
